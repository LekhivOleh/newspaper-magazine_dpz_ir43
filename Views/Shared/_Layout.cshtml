<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — TechPulse</title>
    <meta property="og:site_name" content="TechPulse" />
    <meta property="og:title" content="@(ViewData["OgTitle"] ?? ViewData["Title"])" />
    @if (ViewData["OgDescription"] is string ogDescription)
    {
        <meta property="og:description" content="@ogDescription" />
        <meta name="description" content="@ogDescription" />
    }
    @if (ViewData["OgImage"] is string ogImage)
    {
        <meta property="og:image" content="@ogImage" />
    }
    @if (ViewData["OgUrl"] is string ogUrl)
    {
        <meta property="og:url" content="@ogUrl" />
        <meta property="og:type" content="article" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">Tech<span>Pulse</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <vc:category-nav />
                    <form class="search-form d-flex" method="get" action="/search" role="search">
                        <input class="form-control form-control-sm" type="search" name="q" placeholder="Пошук статей…"
                               aria-label="Пошук" value="@Context.Request.Query["q"]" />
                    </form>
                    <partial name="_UserMenu" />
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            &copy; @DateTime.Now.Year TechPulse — онлайн-журнал про технології
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

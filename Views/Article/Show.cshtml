@model ArticlePageViewModel
@{
    var article = Model.Article.Summary;
    ViewData["Title"] = article.Title;
    ViewData["OgTitle"] = article.Title;
    ViewData["OgDescription"] = article.Lead;
    ViewData["OgImage"] = article.CoverImageUrl;
    ViewData["OgUrl"] = Model.Share.PageUrl;
    var saveMessage = TempData["SaveMessage"] as string;
    var returnUrl = Context.Request.Path.ToString();
}

<article class="article">
    <header class="article-header">
        <a class="kicker" asp-controller="Category" asp-action="Show" asp-route-slug="@article.Category.Slug">@article.Category.Name</a>
        @if (article.AccessLevel == AccessLevel.Premium)
        {
            <span class="badge-premium static">Premium</span>
        }
        <h1 class="article-title">@article.Title</h1>
        <p class="article-lead">@article.Lead</p>

        <div class="article-byline">
            @if (article.Author.AvatarUrl is not null)
            {
                <img class="avatar" src="@article.Author.AvatarUrl" alt="" />
            }
            <div>
                <div class="byline-name">@article.Author.FullName</div>
                <partial name="_ArticleMeta" model="article" />
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="ms-auto d-flex gap-2 align-items-start">
                <partial name="_AddToCollection" model="(article.Id, Model.Collections)" />
                <form method="post" action="/article/@article.Id/save">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn-save @(Model.IsSaved ? "is-saved" : "")">@(Model.IsSaved ? "★ Збережено" : "☆ Зберегти")</button>
                </form>
                </div>
            }
            else
            {
                <a class="btn-save ms-auto" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">☆ Зберегти</a>
            }
        </div>
        @if (saveMessage is not null)
        {
            <p class="save-message">@saveMessage <a asp-controller="Profile" asp-action="Saved">Мій профіль →</a></p>
        }
        @if (TempData[CURSOVA.Controllers.CollectionController.MessageKey] is string collectionMessage)
        {
            <p class="save-message">@collectionMessage <a asp-controller="Profile" asp-action="Collections">Мої підбірки →</a></p>
        }
    </header>

    @if (article.CoverImageUrl is not null)
    {
        <figure class="article-cover">
            <img src="@article.CoverImageUrl" alt="" />
        </figure>
    }

    <div class="article-content">
        <partial name="_Segments" model="Model.Page" />
    </div>

    @if (Model.Article.Access is { IsFull: false } access)
    {
        <section class="paywall">
            <p class="hero-kicker">TechPulse Premium</p>
            <h2>Продовження — для передплатників</h2>
            <p>Ще @UkrainianPlural.Format(access.HiddenBlocks, "розділ", "розділи", "розділів") цієї статті доступні з Premium-підпискою: без реклами, з ексклюзивними фото та відео.</p>
            <a class="btn btn-dark btn-lg" href="/premium">Оформити Premium від 99 грн</a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <p class="small mt-3 mb-0">Уже маєте підписку? <a href="/account/login?returnUrl=@Uri.EscapeDataString(Context.Request.Path)">Увійдіть</a></p>
            }
        </section>
    }

    <partial name="_ShareBar" model="Model.Share" />

    @if (Model.Poll is { } poll)
    {
        <partial name="_PollWidget" model="poll" />
    }

    <partial name="_Comments" model="(Model.Article.Summary.Id, Model.Comments)" />
</article>

@if (Model.Related.Count > 0)
{
    <section class="section">
        <h2 class="section-title">Ще в рубриці «@article.Category.Name»</h2>
        <partial name="_ArticleGrid" model="Model.Related" />
    </section>
}

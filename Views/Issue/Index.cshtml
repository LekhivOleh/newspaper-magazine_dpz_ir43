@model IReadOnlyList<IssueSummaryDto>
@{
    ViewData["Title"] = "Спецвипуски";
}

<header class="page-header">
    <p class="hero-kicker">Спецвипуски</p>
    <h1 class="page-title">Випуски журналу</h1>
    <p class="hero-lead">Тематичні добірки від редакції — найкраще за місяць в одному місці.</p>
</header>

@if (Model.Count == 0)
{
    <p class="empty-state">Випусків поки що немає.</p>
}
else
{
    <div class="issue-grid">
        @foreach (var issue in Model)
        {
            <partial name="_IssueCard" model="issue" />
        }
    </div>
}

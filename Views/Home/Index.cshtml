@model HomeViewModel
@{
    ViewData["Title"] = "Головна";
}

@if (Model.FeaturedIssue is { } issue)
{
    <a class="issue-banner" asp-controller="Issue" asp-action="Show" asp-route-slug="@issue.Slug">
        <span class="issue-badge">Журнал місяця</span>
        <span class="issue-banner-title">@issue.Title</span>
        <span class="issue-banner-cta">@UkrainianPlural.Format(issue.ArticleCount, "матеріал", "матеріали", "матеріалів") · Читати випуск →</span>
    </a>
}

@if (Model.Featured is { } featured)
{
    <section class="featured">
        <a class="featured-cover" asp-controller="Article" asp-action="Show" asp-route-slug="@featured.Slug">
            @if (featured.CoverImageUrl is not null)
            {
                <img src="@featured.CoverImageUrl" alt="" />
            }
        </a>
        <div class="featured-body">
            <p class="hero-kicker">Головне · @featured.Category.Name</p>
            <h1 class="featured-title">
                <a asp-controller="Article" asp-action="Show" asp-route-slug="@featured.Slug">@featured.Title</a>
            </h1>
            <p class="hero-lead">@featured.Lead</p>
            <partial name="_ArticleMeta" model="featured" />
        </div>
    </section>
}

@if (Model.Recommendations is { Items.Count: > 0 } recommended)
{
    <section class="section">
        <div class="d-flex justify-content-between align-items-end section-title">
            <h2 class="m-0" style="font: inherit">@recommended.StrategyTitle</h2>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="small fw-semibold" style="font-family: var(--tp-sans)" href="/profile/recommendations">Більше для вас →</a>
            }
        </div>
        <partial name="_RecommendedGrid" model="recommended.Items" />
    </section>
}

<section class="section">
    <h2 class="section-title">@(Model.Pager.Page == 1 ? "Свіжі матеріали" : "Архів")</h2>
    <partial name="_ArticleGrid" model="Model.Articles" />
    <partial name="_Pagination" model="Model.Pager" />
</section>

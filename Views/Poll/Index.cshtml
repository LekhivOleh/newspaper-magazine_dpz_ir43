@model IReadOnlyList<PollDto>
@{
    ViewData["Title"] = "Опитування";
}

<header class="page-header">
    <p class="hero-kicker"><a href="/interactive">Інтерактив</a></p>
    <h1 class="page-title">Опитування</h1>
    <p class="hero-lead">Діліться думкою — і дивіться, що думають інші читачі TechPulse.</p>
</header>

@if (Model.Count == 0)
{
    <p class="empty-state">Опитувань поки що немає.</p>
}
else
{
    <div class="poll-grid">
        @foreach (var poll in Model)
        {
            <partial name="_PollWidget" model="poll" />
        }
    </div>
}

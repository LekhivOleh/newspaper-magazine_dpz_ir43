@model ArticleForm
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var form = Model;
    var isNew = form.Id is null;
    ViewData["Title"] = isNew ? "Нова стаття" : "Редагування статті";
}

<div class="admin-header">
    <h1>@ViewData["Title"]</h1>
    @if (!isNew)
    {
        <a class="btn btn-outline-dark" asp-action="Content" asp-route-id="@form.Id">Редагувати контент →</a>
    }
</div>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@form.Id" method="post" class="admin-card admin-form" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control form-control-lg" autofocus />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Lead" class="form-label"></label>
        <textarea asp-for="Lead" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Lead" class="text-danger small"></span>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" asp-items='(IEnumerable<SelectListItem>)ViewData["Categories"]!' class="form-select">
                <option value="0">— оберіть —</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger small"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="AuthorId" class="form-label"></label>
            <select asp-for="AuthorId" asp-items='(IEnumerable<SelectListItem>)ViewData["Authors"]!' class="form-select">
                <option value="0">— оберіть —</option>
            </select>
            <span asp-validation-for="AuthorId" class="text-danger small"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="CoverImageUrl" class="form-label"></label>
        <input asp-for="CoverImageUrl" class="form-control" placeholder="https://…" />
        <span asp-validation-for="CoverImageUrl" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SponsorPartnerId" class="form-label"></label>
        <select asp-for="SponsorPartnerId" asp-items='(IEnumerable<SelectListItem>)ViewData["Partners"]!' class="form-select">
            <option value="">— звичайна редакційна стаття —</option>
        </select>
        <div class="form-text">Спонсорована стаття отримує плашку «Партнерський матеріал» для всіх читачів.</div>
    </div>
    <div class="mb-4">
        <label class="form-label d-block">Доступ</label>
        <div class="btn-group" role="group">
            <input type="radio" class="btn-check" name="AccessLevel" id="access-free" value="Free" checked="@(form.AccessLevel == AccessLevel.Free)" />
            <label class="btn btn-outline-dark" for="access-free">Безкоштовна</label>
            <input type="radio" class="btn-check" name="AccessLevel" id="access-premium" value="Premium" checked="@(form.AccessLevel == AccessLevel.Premium)" />
            <label class="btn btn-outline-warning" for="access-premium">Premium</label>
        </div>
    </div>

    <button type="submit" class="btn btn-dark">@(isNew ? "Створити чернетку" : "Зберегти")</button>
    <a asp-action="Index" class="btn btn-link">Скасувати</a>
</form>

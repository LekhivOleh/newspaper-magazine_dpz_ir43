@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    string Active(string name) => controller == name ? "active" : "";
    var flash = TempData["AdminFlash"] as string;
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Адмінка TechPulse</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Tech<span>Pulse</span><small>адмінка</small></a>
            <nav class="admin-nav">
                <a class="@Active("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Огляд</a>
                <a class="@Active("Articles")" asp-area="Admin" asp-controller="Articles" asp-action="Index">Статті</a>
                <a class="@Active("Issues")" asp-area="Admin" asp-controller="Issues" asp-action="Index">Спецвипуски</a>
                <a class="@Active("Quizzes")" asp-area="Admin" asp-controller="Quizzes" asp-action="Index">Тести</a>
                <a class="@Active("Polls")" asp-area="Admin" asp-controller="Polls" asp-action="Index">Опитування</a>
                <a class="@Active("Categories")" asp-area="Admin" asp-controller="Categories" asp-action="Index">Рубрики</a>
                <a class="@Active("Authors")" asp-area="Admin" asp-controller="Authors" asp-action="Index">Автори</a>
            </nav>
            <div class="admin-sidebar-footer">
                <a asp-area="" asp-controller="Home" asp-action="Index">← На сайт</a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-link p-0">Вийти</button>
                </form>
            </div>
        </aside>

        <main class="admin-main">
            @if (flash is not null)
            {
                <div class="alert alert-info alert-dismissible fade show" role="status">
                    @flash
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрити"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

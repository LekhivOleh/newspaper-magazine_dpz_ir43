@using CURSOVA.Application.Subscriptions
@using CURSOVA.Domain.Subscriptions
@model IReadOnlyList<SubscriberDto>
@{
    ViewData["Title"] = "Підписки";
    var stats = (SubscriptionStatsDto)ViewData["Stats"]!;
}

<div class="admin-header">
    <h1>Підписки</h1>
</div>

<div class="stat-grid mb-4">
    <div class="stat"><span class="stat-value">@stats.PremiumReaders</span><span class="stat-label">Читачів із Premium</span></div>
    <div class="stat"><span class="stat-value">@stats.AutoRenewing</span><span class="stat-label">З автопродовженням</span></div>
    <div class="stat"><span class="stat-value">@stats.TotalRevenueUah</span><span class="stat-label">Дохід, грн (демо)</span></div>
</div>

<form asp-action="Gift" method="post" class="admin-card p-3 mb-4 d-flex flex-wrap gap-2 align-items-end">
    <div>
        <label class="form-label small mb-1">Подарувати Premium</label>
        <input name="email" type="email" class="form-control form-control-sm" placeholder="email читача" required />
    </div>
    <div>
        <label class="form-label small mb-1">Днів</label>
        <input name="days" type="number" class="form-control form-control-sm" value="30" min="1" max="366" style="width: 6rem" />
    </div>
    <button type="submit" class="btn btn-sm btn-dark">Подарувати</button>
</form>

<div class="admin-card">
    <table class="table admin-table mb-0">
        <thead>
            <tr><th>Читач</th><th>Стан</th><th>Тариф</th><th>Діє до</th><th>Оплачено</th><th></th></tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Підписок ще немає.</td></tr>
            }
            @foreach (var row in Model)
            {
                var s = row.Subscription;
                <tr>
                    <td><strong>@row.DisplayName</strong><div class="small text-muted">@row.Email</div></td>
                    <td>
                        <span class="badge @(s.Status switch
                        {
                            SubscriptionStatus.Active => "text-bg-success",
                            SubscriptionStatus.Cancelled => "text-bg-warning",
                            SubscriptionStatus.Expired => "text-bg-secondary",
                            _ => "text-bg-light"
                        })">@s.StatusTitle</span>
                    </td>
                    <td class="small">@(s.Plan?.Title ?? "—")</td>
                    <td class="small">@(s.CurrentPeriodEnd?.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "—")</td>
                    <td>@row.TotalPaidUah грн</td>
                    <td class="text-end">
                        @if (s.HasPremium)
                        {
                            <form asp-action="EndPeriod" asp-route-id="@row.SubscriptionId" method="post"
                                  data-confirm="Завершити поточний період зараз? Активна підписка автопродовжиться, скасована — завершиться.">
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Для демонстрації переходів між станами">⏩ Завершити період</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}

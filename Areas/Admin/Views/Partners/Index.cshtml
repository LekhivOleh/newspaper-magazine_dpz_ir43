@using CURSOVA.Application.Advertising
@model IReadOnlyList<PartnerDto>
@{
    ViewData["Title"] = "Партнери";
}

<div class="admin-header">
    <h1>Партнери</h1>
    <a class="btn btn-dark" asp-action="Create">+ Новий партнер</a>
</div>

<div class="admin-card">
    <table class="table admin-table mb-0">
        <thead><tr><th></th><th>Бренд</th><th>Сайт</th><th>Статус</th><th></th></tr></thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">Партнерів ще немає.</td></tr>
            }
            @foreach (var p in Model)
            {
                <tr>
                    <td style="width: 3.5rem">
                        @if (p.LogoUrl is not null)
                        {
                            <img class="admin-avatar" src="@p.LogoUrl" alt="" />
                        }
                    </td>
                    <td><a asp-action="Edit" asp-route-id="@p.Id" class="fw-semibold">@p.Name</a><div class="small text-muted">@p.Tagline</div></td>
                    <td class="small"><a href="@p.WebsiteUrl" target="_blank" rel="noopener">@p.WebsiteUrl</a></td>
                    <td>@(p.IsActive ? Html.Raw("<span class=\"badge text-bg-success\">Активний</span>") : Html.Raw("<span class=\"badge text-bg-secondary\">Вимкнений</span>"))</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@p.Id">Редагувати</a>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" data-confirm="Видалити партнера «@p.Name»?">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Видалити</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}

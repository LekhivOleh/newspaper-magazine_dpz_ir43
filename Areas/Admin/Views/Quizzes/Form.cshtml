@using CURSOVA.Domain.Interactive.Quizzes
@using Microsoft.AspNetCore.Mvc.Rendering
@model QuizForm
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "Новий тест" : "Опис тесту";
}

<div class="admin-header">
    <h1>@ViewData["Title"]</h1>
    @if (!isNew)
    {
        <a class="btn btn-outline-dark" asp-action="Definition" asp-route-id="@Model.Id">Питання та результати →</a>
    }
</div>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="admin-card admin-form" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control form-control-lg" autofocus />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="CoverImageUrl" class="form-label"></label>
        <input asp-for="CoverImageUrl" class="form-control" placeholder="https://…" />
        <span asp-validation-for="CoverImageUrl" class="text-danger small"></span>
    </div>
    @if (isNew)
    {
        <div class="mb-3">
            <label asp-for="ScoringMode" class="form-label"></label>
            <select asp-for="ScoringMode" class="form-select">
                <option value="@ScoringMode.CorrectAnswers">Тест на знання — правильні відповіді, рівні у %</option>
                <option value="@ScoringMode.Personality">«Хто ви?» — найчастіший результат</option>
                <option value="@ScoringMode.Points">Самоперевірка — сума балів</option>
            </select>
            <div class="form-text">Тип можна змінити пізніше в редакторі питань.</div>
        </div>
    }
    <div class="mb-4">
        <label asp-for="ArticleId" class="form-label"></label>
        <select asp-for="ArticleId" asp-items='(IEnumerable<SelectListItem>)ViewData["Articles"]!' class="form-select">
            <option value="">— без статті —</option>
        </select>
    </div>

    <button type="submit" class="btn btn-dark">@(isNew ? "Створити" : "Зберегти")</button>
    <a asp-action="Index" class="btn btn-link">Скасувати</a>
</form>

@model IssueStructurePage
@{
    var issue = Model.Issue.Summary;
    ViewData["Title"] = issue.Title;
    var usedArticleIds = Model.Issue.Root.Descendants().OfType<ArticleNodeDto>().Select(a => a.Article.Id).ToHashSet();
}

<div class="admin-header">
    <div>
        <p class="text-muted small mb-1"><a asp-action="Index">Спецвипуски</a> / <a asp-action="Edit" asp-route-id="@issue.Id">редагувати опис</a></p>
        <h1>@issue.Title</h1>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap justify-content-end">
        @if (issue.IsPublished)
        {
            <span class="badge text-bg-success">Опубліковано</span>
            <form asp-action="@(issue.IsFeatured ? "Unfeature" : "Feature")" asp-route-id="@issue.Id" method="post">
                <button type="submit" class="btn btn-sm @(issue.IsFeatured ? "btn-warning" : "btn-outline-warning")">
                    @(issue.IsFeatured ? "★ Журнал місяця" : "☆ Зробити «Журналом місяця»")
                </button>
            </form>
            <form asp-action="Unpublish" asp-route-id="@issue.Id" method="post">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Зняти з публікації</button>
            </form>
            <a class="btn btn-sm btn-outline-dark" asp-area="" asp-controller="Issue" asp-action="Show" asp-route-slug="@issue.Slug" target="_blank">На сайті ↗</a>
        }
        else
        {
            <span class="badge text-bg-secondary">Чернетка</span>
            <form asp-action="Publish" asp-route-id="@issue.Id" method="post">
                <button type="submit" class="btn btn-sm btn-success">Опублікувати</button>
            </form>
        }
    </div>
</div>

<div class="issue-structure-layout">
    <div>
        <h2 class="admin-subtitle mt-0">Структура · @UkrainianPlural.Format(issue.ArticleCount, "матеріал", "матеріали", "матеріалів")</h2>
        <div class="admin-card p-3">
            @if (Model.Issue.Root.Children.Count == 0)
            {
                <p class="text-muted text-center py-4 mb-0">Випуск порожній. Додайте розділ або статтю →</p>
            }
            <partial name="_StructureChildren" model="Model.Issue.Root" view-data='new ViewDataDictionary(ViewData) { ["IssueId"] = issue.Id }' />
        </div>
    </div>

    <aside class="d-flex flex-column gap-3">
        <form asp-action="AddSection" asp-route-id="@issue.Id" method="post" class="admin-card p-3">
            <h3 class="h6 fw-semibold">Новий розділ</h3>
            <input name="title" class="form-control form-control-sm mb-2" placeholder="Назва розділу" required maxlength="150" />
            <select name="parentId" class="form-select form-select-sm mb-2">
                @foreach (var option in Model.Sections)
                {
                    <option value="@option.Id">@option.Label</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-dark w-100">Додати розділ</button>
        </form>

        <form asp-action="AddArticle" asp-route-id="@issue.Id" method="post" class="admin-card p-3">
            <h3 class="h6 fw-semibold">Додати статтю</h3>
            <select name="articleId" class="form-select form-select-sm mb-2" required>
                <option value="">— стаття —</option>
                @foreach (var article in Model.Articles.Where(a => !usedArticleIds.Contains(a.Id)))
                {
                    <option value="@article.Id">@article.Title</option>
                }
            </select>
            <select name="parentId" class="form-select form-select-sm mb-2">
                @foreach (var option in Model.Sections)
                {
                    <option value="@option.Id">у: @option.Label</option>
                }
            </select>
            <input name="editorNote" class="form-control form-control-sm mb-2" placeholder="Коментар редактора (необов'язково)" maxlength="300" />
            <button type="submit" class="btn btn-sm btn-dark w-100">Додати статтю</button>
        </form>
    </aside>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
